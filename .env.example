# Paths (relative to repo root)
HC_DATA_RAW_DIR=data/raw
HC_DATA_PROCESSED_DIR=data/processed
HC_ARTIFACTS_DIR=artifacts
HC_ASSET_ROOT=study

# API
HC_API_HOST=127.0.0.1
HC_API_PORT=8000
HC_EXPERIMENTAL_CONDITION=baseline  # fallback if URL omits ?condition=
HC_ENVIRONMENT=local                # local | production
HC_STORAGE_BACKEND=sqlite           # production requires postgres
# HC_DATABASE_URL=postgresql://...   # use sslmode=verify-full in Azure
HC_ENFORCE_PROGRESSION=false
HC_RECRUITMENT_ENABLED=false
HC_ENROLLMENT_NAMESPACE=test        # TEST-### codes; pilot uses P### only after authorization
HC_ALLOW_SYNTHETIC_LAUNCH=true      # production should be false after TEST validation
HC_RELEASE_MANIFEST_PATH=release/release-manifest.json
# HC_SESSION_SECRET=
# HC_INTEGRATION_SECRET=
# HC_ADMIN_TOKEN=                    # local tests only; production admin requires Entra
# HC_ENTRA_TENANT_ID=
# HC_ENTRA_AUDIENCE=
# HC_ENTRA_ADMIN_ROLE=MedAstraX.ResearchAdmin
# HC_CORS_ORIGINS=https://approved.example.edu
HC_RETENTION_POLICY=unresolved
# HC_PAYMENT_TUTORIAL_FAIL_CENTS=    # deliberately unset pending PI decision

# LLM settings are freeze-time development only. Live generation is blocked in study mode.
HC_LLM_PROVIDER=
HC_LLM_API_KEY=
HC_LLM_MODEL=

# Study instrumentation (Phase 8)
HC_STUDY_ID=pilot-001
HC_STUDY_MODE=false
HC_LOG_EVENTS=true  # writes artifacts/logs/events.jsonl + events.sqlite

# Modeling: XGBoost is required for frozen study artifacts. Local prototyping only:
# HC_ALLOW_LOGISTIC_FALLBACK=true

# Explanation stability for study cases: bootstrap | margin
HC_STABILITY_METHOD=bootstrap
HC_BOOTSTRAP_ITERATIONS=5

# Optional named LLM for freeze-time generation (still requires human adjudication)
# HC_LLM_PROVIDER=openai
# HC_LLM_API_KEY=
# HC_LLM_MODEL=
# HC_LLM_TEMPERATURE=0
# HC_LLM_MAX_ATTEMPTS=8
# HC_LLM_RETRY_BASE_SECONDS=1
# HC_LLM_RETRY_CAP_SECONDS=30
